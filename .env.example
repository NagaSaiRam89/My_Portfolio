# ─── Contact form ────────────────────────────────────────────────────────────
# Create a form at https://formspree.io or https://web3forms.com and paste the
# POST URL here, then restart `npm run dev`. Leave unset and the site shows a
# direct-email panel instead of a form (honest, and fine to ship).
VITE_CONTACT_ENDPOINT=

# ─── "Ask this portfolio" widget ─────────────────────────────────────────────
# Server-side only — never prefix these with VITE_, or they ship to the browser.
# Set GEMINI_API_KEY in your Vercel project's Environment Variables, and locally
# (once) to run `npm run embed`. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides. Defaults: gemini-3.8-flash and gemini-embedding-001.
# If a model ID 404s, the /api/ask logs will say so — swap it here.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
